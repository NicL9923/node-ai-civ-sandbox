<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wraps the Kiota-generated C# federation client/models so `dotnet build`
    proves the generated contract compiles. The generated sources live in
    ../generated/csharp/** (regenerated by `npm run generate:contracts`) and are
    intentionally kept out of this project directory so the drift gate can treat
    them as pure build output.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AiCiv.FederationContracts</RootNamespace>
    <AssemblyName>AiCiv.FederationContracts</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Generated code: relax XML-doc and unused-usings noise. -->
    <NoWarn>$(NoWarn);CS1591;CS8019;IDE0005</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\generated\csharp\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle = abstractions + serialization + HTTP (see `kiota info -l CSharp`). -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

</Project>
