<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WorldMap.Core\WorldMap.Core.csproj" />
    <ProjectReference Include="..\WorldMap.Infrastructure\WorldMap.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Observer SPA (apps/world-map/web) integration. On `dotnet publish`, build the web assets
       (when npm is available) and copy them into the publish output's wwwroot so the published app
       serves a working SPA (overwriting the placeholder index.html). Pure `dotnet build`/`test` is
       unaffected: these targets run only on Publish. Set BuildSpa=false to skip the npm build
       (e.g. when CI already produced web/dist). -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..\..\..</RepoRoot>
    <SpaDistDir>$(MSBuildProjectDirectory)\..\..\web\dist</SpaDistDir>
    <BuildSpa Condition="'$(BuildSpa)' == ''">true</BuildSpa>
  </PropertyGroup>

  <Target Name="BuildSpaAssets"
          Condition="'$(BuildSpa)' == 'true' And !Exists('$(SpaDistDir)\index.html')">
    <Message Importance="high" Text="Building observer SPA (apps/world-map/web)..." />
    <Exec Command="npm run build -w apps/world-map/web" WorkingDirectory="$(RepoRoot)"
          ContinueOnError="true" />
  </Target>

  <Target Name="CopySpaToPublish" AfterTargets="Publish" DependsOnTargets="BuildSpaAssets"
          Condition="Exists('$(SpaDistDir)\index.html')">
    <ItemGroup>
      <_SpaFile Include="$(SpaDistDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpaFile)"
          DestinationFiles="@(_SpaFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
    <!-- Drop stale precompressed copies of the placeholder index (the real SPA index replaced it). -->
    <Delete Files="$(PublishDir)wwwroot\index.html.br;$(PublishDir)wwwroot\index.html.gz" />
    <Message Importance="high" Text="Copied observer SPA into $(PublishDir)wwwroot." />
  </Target>

</Project>
