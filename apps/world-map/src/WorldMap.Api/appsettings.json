{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorldMap": {
    "ProtocolVersion": "1.0.0",
    "WorldBaseUrl": "https://world.example.com/world/v1",
    "Storage": {
      "Provider": "InMemory",
      "DatabaseName": "worldmap"
    },
    "Onboarding": {
      "Records": []
    },
    "Secrets": {
      "Map": {}
    },
    "Liveness": {
      "StaleAfterSeconds": 90,
      "OfflineAfterSeconds": 300,
      "SuggestedHeartbeatSeconds": 30
    },
    "Interaction": {
      "CommandTtlSeconds": 604800,
      "IdempotencyTtlSeconds": 86400
    },
    "Maintenance": {
      "Enabled": true,
      "SweepIntervalSeconds": 30
    }
  }
}
