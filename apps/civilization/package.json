{
  "name": "node-ai-civ-sandbox",
  "version": "0.1.0",
  "description": "AI civilization sandbox for Azure App Service",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run typecheck:client && npm run build:client && npm run build:server",
    "typecheck:client": "node ../../node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.json",
    "build:client": "vite build",
    "build:server": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "dependencies": {
    "@ai-civ/federation-contracts": "*",
    "@azure/ai-projects": "^2.10.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/identity": "^4.14.1",
    "applicationinsights": "^3.17.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.47.0",
    "openapi-fetch": "0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
