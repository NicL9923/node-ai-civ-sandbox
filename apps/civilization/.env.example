PORT=3000
SIMULATION_ID=default
SIM_AUTO_START=true
TURN_INTERVAL_MS=30000
ACTORS_PER_TURN=2
# Anti-loop tuning: max talks in a row before a non-converse action is required,
# and how many quiet turns before the prompt encourages conversation.
MAX_CONSECUTIVE_CONVERSES=3
CONVERSATION_SILENCE_THRESHOLD=8
ADMIN_API_KEY=replace-with-a-long-random-value

# Use "mock" for local development without model calls, "foundry" in Azure.
AI_PROVIDER=mock
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
GPT_5_4_DEPLOYMENT_NAME=gpt-5.4
GROK_43_DEPLOYMENT_NAME=grok-4.3
DEEPSEEK_V4_PRO_DEPLOYMENT_NAME=DeepSeek-V4-Pro
FOUNDRY_API_KEY=

# If COSMOS_ENDPOINT is unset, the app uses an in-memory store.
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE_ID=sandbox

# --- World federation connector (OPTIONAL) ---
# The connector is OFF unless WORLD_API_BASE_URL is set. When unset the app runs as a standalone
# civilization with no behavior change. All values below are only read when the connector is enabled.
#
# Base URL of the World API, INCLUDING the /world/v1 path prefix (the HMAC signature covers the full path).
# WORLD_API_BASE_URL=https://world.example.com/world/v1
# Protocol major version. Must be "1".
# WORLD_PROTOCOL_VERSION=1
# S2S HMAC signing secret, exchanged out-of-band. REQUIRED whenever federation is enabled. Never logged.
# WORLD_HMAC_SECRET=
# Pre-provisioned credentials (use these OR an onboarding token below).
# WORLD_CIV_ID=
# WORLD_KEY_ID=
# One-time onboarding token to self-register (the World then assigns civId/keyId; pair it with WORLD_HMAC_SECRET).
# WORLD_ONBOARDING_TOKEN=
# Public display name for this civilization (defaults to SIMULATION_ID).
# WORLD_DISPLAY_NAME=
# Background loop intervals (milliseconds).
# WORLD_HEARTBEAT_INTERVAL_MS=30000
# WORLD_POLL_INTERVAL_MS=10000
# WORLD_OUTBOX_INTERVAL_MS=5000
#
# --- World Wire (social) sub-feature (OPTIONAL) ---
# Only active when federation is enabled (WORLD_API_BASE_URL set). Set WORLD_SOCIAL_ENABLED=false to run
# federation without the social feed/accounts. All values below are read only when federation is enabled.
# WORLD_SOCIAL_ENABLED=true
# How often the connector reconciles account sync (debounced by a content fingerprint).
# WORLD_SOCIAL_SYNC_INTERVAL_MS=60000
# How often the connector polls the public global feed (first-page snapshot).
# WORLD_SOCIAL_FEED_INTERVAL_MS=20000
# Max posts requested per feed poll (the server may return fewer).
# WORLD_SOCIAL_FEED_LIMIT=50
# Max posts retained in the bounded cached feed.
# WORLD_SOCIAL_FEED_CACHE_MAX=100
# Max compact social briefing lines kept.
# WORLD_SOCIAL_BRIEFING_MAX=5
# Minimum spacing between account syncs even when the fingerprint changes.
# WORLD_SOCIAL_SYNC_DEBOUNCE_MS=15000
# Upper bound (ms) honored from a 429 Retry-After before falling back to normal backoff.
# WORLD_SOCIAL_MAX_RETRY_AFTER_MS=60000
# Max recent feed items surfaced into a single agent prompt.
# WORLD_SOCIAL_PROMPT_FEED_ITEMS=8
