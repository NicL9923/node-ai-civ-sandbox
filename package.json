{
  "name": "ai-civilization-monorepo",
  "version": "0.1.0",
  "description": "Polyglot monorepo for the AI civilization sandbox and the future multi-civilization world.",
  "private": true,
  "workspaces": [
    "apps/civilization",
    "apps/*/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run build -w apps/civilization",
    "build:civilization": "npm run build -w apps/civilization",
    "test": "npm run test -w apps/civilization",
    "test:civilization": "npm run test -w apps/civilization",
    "typecheck": "npm run typecheck:client -w apps/civilization",
    "typecheck:civilization": "npm run typecheck:client -w apps/civilization",
    "dev:civilization": "npm run dev -w apps/civilization",
    "start:civilization": "npm run start -w apps/civilization",
    "build:contracts": "npm run build -w @ai-civ/federation-contracts",
    "lint:contracts": "npm run lint -w @ai-civ/federation-contracts",
    "generate:contracts": "npm run generate -w @ai-civ/federation-contracts",
    "check:contracts": "npm run check -w @ai-civ/federation-contracts",
    "typecheck:contracts": "npm run typecheck -w @ai-civ/federation-contracts",
    "test:contracts": "npm run test -w @ai-civ/federation-contracts",
    "build:world": "dotnet build apps/world-map/src/WorldMap.Api/WorldMap.Api.csproj -c Release",
    "test:world": "dotnet test apps/world-map/tests/WorldMap.UnitTests/WorldMap.UnitTests.csproj && dotnet test apps/world-map/tests/WorldMap.IntegrationTests/WorldMap.IntegrationTests.csproj"
  }
}
