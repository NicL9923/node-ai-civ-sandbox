PORT=3000
SIMULATION_ID=default
SIM_AUTO_START=true
TURN_INTERVAL_MS=30000
ACTORS_PER_TURN=2
ADMIN_API_KEY=replace-with-a-long-random-value

# Use "mock" for local development without model calls, "foundry" in Azure.
AI_PROVIDER=mock
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
GPT55_DEPLOYMENT_NAME=gpt-5.5
CLAUDE_SONNET5_DEPLOYMENT_NAME=claude-sonnet-5
FOUNDRY_API_KEY=

# If COSMOS_ENDPOINT is unset, the app uses an in-memory store.
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE_ID=sandbox
